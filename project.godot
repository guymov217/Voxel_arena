; WRECKSMITH (formerly Voxel Arena), Godot 4 port. The content (weapons, bodies, beasts, stages) is exported from the
; web game by tools/export-godot.mjs into data/.
config_version=5

[application]

config/name="WRECKSMITH"
config/version="0.1"
config/description="Physics gladiator fights in voxels"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[autoload]

Data="*res://scripts/autoload/data.gd"
Save="*res://scripts/autoload/save.gd"
Net="*res://scripts/net/net.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[audio]

driver/enable_input=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
common/physics_interpolation=true
jolt_physics_3d/simulation/velocity_steps=12
jolt_physics_3d/simulation/position_steps=12
3d/default_gravity=9.81

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=96

[debug]

gdscript/warnings/inference_on_variant=0
